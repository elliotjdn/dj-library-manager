# Virtual environment
.venv/

# Python-generated files
__pycache__/
*.py[cod]
.pytest_cache/

# VS Code personal settings
.vscode/

# Environment variables
.env

# Audio files
*.mp3
*.wav
*.flac
*.aiff
*.aif
*.m4a
*.ogg

# Runtime data
data/inbox/*
data/processed/*
data/backups/*

# Keep the folder structure
!data/inbox/.gitkeep
!data/processed/.gitkeep
!data/backups/.gitkeep

# Future databases and ML models
*.db
*.sqlite
*.pkl
*.joblib
